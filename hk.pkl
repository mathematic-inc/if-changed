amends ".hk/org.pkl"

steps {
  ["cargo-lockfile"] = new Step {
    glob = List("Cargo.toml", "Cargo.lock", "**/Cargo.toml")
    check = "cargo metadata --locked --format-version 1 --all-features > /dev/null"
    profiles = List("slow")
  }
  // The oxfmt binary of mise has no `--stdin-filepath`, which its builtin diff and fix use.
  ["oxfmt"] {
    check_diff = null
    fix = "oxfmt --write --no-error-on-unmatched-pattern {{ files }}"
  }
}
